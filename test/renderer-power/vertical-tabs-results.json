  "configuration": "# Existing preferences.\ncopy-on-select = clipboard\nmacos-titlebar-style = tabs\n\n# Dark CRT edge color also sets the macOS tab titlebar color.\n# The shader gently lifts the screen center above this base.\n# Homebrew with lightness-first AA contrast adjustments for ANSI text slots 1-15.\n# Source colors clear 4.5:1 against the brightest current CRT screen background.\n# ANSI 0 stays dark for backgrounds/inverse text and is the documented exception.\n# CRT post-processing and app-defined colors can reduce contrast below AA.\n# Original palette: https://terminalthemes.com/themes/homebrew\nbackground = #070e0a\nforeground = #00ff00\nselection-background = #083905\nselection-foreground = #ffffff\ncursor-color = #23ff18\ncursor-text = #000000\npalette = 0=#070e0a\npalette = 1=#dd5343\npalette = 2=#00a600\npalette = 3=#999900\npalette = 4=#4079ff\npalette = 5=#d43cd3\npalette = 6=#00a6b2\npalette = 7=#bfbfbf\npalette = 8=#818181\npalette = 9=#ff5948\npalette = 10=#00d900\npalette = 11=#e5e500\npalette = 12=#5f91ff\npalette = 13=#f72df6\npalette = 14=#00e5e5\npalette = 15=#e5e5e5\n\nfont-family = Cascadia Code\nfont-size = 14\nfont-feature = calt, liga\ncursor-style = block\ncursor-style-blink = false\n# Preserve the block cursor at shell prompts.\nshell-integration-features = no-cursor\n\nbackground-opacity = 1\nwindow-padding-x = 14\nwindow-padding-y = 14\n\n# Static CRT effects. Comment out custom-shader to disable them.\ncustom-shader = /Volumes/T7/Projects/ghostty/test/renderer-power/high.glsl\ncustom-shader-animation = false\n\n# Offscreen throughput is intentionally uncapped.\nwindow-vsync = false\n",
